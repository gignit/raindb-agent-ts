{
  "name": "@raindb/agent",
  "version": "0.3.0",
  "description": "Shared TypeScript agent runtime + tool catalog for RainDB consumer apps (fdn-app, raindb-app). Mirrors raindb-phoenix-oc/internal/ai/.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-reporter=spec test/unit/*.test.ts",
    "test:int": "node --import tsx --test --test-reporter=spec test/integration/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openai": "^6.36.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gignit/raindb-agent-ts.git"
  }
}
