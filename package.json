{
  "name": "@raindb/agent",
  "version": "0.8.2",
  "description": "TypeScript LLM agent loop + tool catalog over RainDB's data primitives. Sister package to @raindb/bolt-sdk; embed in a bolt handler or run on Node.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-reporter=spec test/unit/*.test.ts",
    "test:int": "node --import tsx --test --test-reporter=spec test/integration/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openai": "^6.36.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gignit/raindb-agent-ts.git"
  }
}
